{
  "uid": "sensor-overview",
  "title": "Sensor overview",
  "tags": [
    "sensors"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "label": "DB",
        "hide": 2,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "sensor",
        "label": "Sensor",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT id AS __value, id || ' (' || sensor_type || ')' AS __text FROM v_sensor ORDER BY id",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online sensors",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'online') AS online, count(*) AS total FROM v_sensor_status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Sensor status (now)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 20,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.id AS sensor, s.sensor_type AS type, COALESCE(st.status, 'unknown') AS status,\n       st.last_seen_at AS \"last seen\", st.last_seq AS \"last seq\", st.status_changed_at AS \"since\"\nFROM v_sensor s LEFT JOIN v_sensor_status st ON st.sensor_id = s.id\nWHERE s.id IN ($sensor) ORDER BY s.id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "online": {
                        "color": "green",
                        "text": "online"
                      },
                      "offline": {
                        "color": "red",
                        "text": "offline"
                      },
                      "unknown": {
                        "color": "gray",
                        "text": "unknown"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Availability timeline",
      "description": "sensor_event 전이 기반. 값이 바뀐 시점부터 다음 전이까지 상태가 유지된다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, sensor_id::text AS metric,\n       CASE WHEN event_type IN ('connected', 'recovered') THEN 1 ELSE 0 END AS value\nFROM v_sensor_event\nWHERE $__timeFilter(time) AND sensor_id IN ($sensor)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "color": "green",
                  "text": "online",
                  "index": 0
                },
                "0": {
                  "color": "red",
                  "text": "offline",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Availability % (selected range)",
      "description": "선택 구간에서 online 으로 기록된 시간 비율. 구간 시작 이전의 마지막 전이 상태를 반영한다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT sensor_id, time,\n         CASE WHEN event_type IN ('connected', 'recovered') THEN 1 ELSE 0 END AS up,\n         LEAD(time, 1, $__timeTo()::timestamptz) OVER (PARTITION BY sensor_id ORDER BY time) AS next_time\n  FROM v_sensor_event\n  WHERE time < $__timeTo()::timestamptz AND sensor_id IN ($sensor)\n)\nSELECT sensor_id::text AS sensor,\n       100.0 * COALESCE(SUM(EXTRACT(EPOCH FROM LEAST(next_time, $__timeTo()::timestamptz) - GREATEST(time, $__timeFrom()::timestamptz)))\n                        FILTER (WHERE up = 1 AND next_time > $__timeFrom()::timestamptz), 0)\n             / NULLIF(EXTRACT(EPOCH FROM $__timeTo()::timestamptz - $__timeFrom()::timestamptz), 0) AS availability\nFROM ev GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Connection events",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time,\n       concat('sensor ', sensor_id, ' ', upper(event_type), ' [', source, '] ', message) AS message,\n       CASE WHEN event_type IN ('disconnected', 'timeout') THEN 'error' ELSE 'info' END AS level,\n       sensor_id::text AS sensor\nFROM v_sensor_event\nWHERE $__timeFilter(time) AND sensor_id IN ($sensor)\nORDER BY time DESC LIMIT 500"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tilt (°)",
      "description": "기울기 tilt_x / tilt_y. 1시간 초과 구간은 1분 집계, 이하는 원본을 $__interval 로 평균.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, sensor_id::text || ' ' || metric AS metric, value_avg AS value\nFROM v_sensor_data_1m\nWHERE $__timeFilter(bucket) AND sensor_id IN ($sensor) AND metric IN ('tilt_x', 'tilt_y') AND (($__to - $__from) > 3600000)\nUNION ALL\nSELECT $__timeGroup(time, $__interval) AS time, sensor_id::text || ' ' || metric AS metric, avg(value) AS value\nFROM v_sensor_data\nWHERE $__timeFilter(time) AND sensor_id IN ($sensor) AND metric IN ('tilt_x', 'tilt_y') AND NOT (($__to - $__from) > 3600000)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Crack width (mm)",
      "description": "균열 폭.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, sensor_id::text || ' ' || metric AS metric, value_avg AS value\nFROM v_sensor_data_1m\nWHERE $__timeFilter(bucket) AND sensor_id IN ($sensor) AND metric IN ('crack_width') AND (($__to - $__from) > 3600000)\nUNION ALL\nSELECT $__timeGroup(time, $__interval) AS time, sensor_id::text || ' ' || metric AS metric, avg(value) AS value\nFROM v_sensor_data\nWHERE $__timeFilter(time) AND sensor_id IN ($sensor) AND metric IN ('crack_width') AND NOT (($__to - $__from) > 3600000)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmm",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Temperature (°C)",
      "description": "온도.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, sensor_id::text || ' ' || metric AS metric, value_avg AS value\nFROM v_sensor_data_1m\nWHERE $__timeFilter(bucket) AND sensor_id IN ($sensor) AND metric IN ('temperature') AND (($__to - $__from) > 3600000)\nUNION ALL\nSELECT $__timeGroup(time, $__interval) AS time, sensor_id::text || ' ' || metric AS metric, avg(value) AS value\nFROM v_sensor_data\nWHERE $__timeFilter(time) AND sensor_id IN ($sensor) AND metric IN ('temperature') AND NOT (($__to - $__from) > 3600000)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Data completeness (%)",
      "description": "1분 버킷의 수신 건수 / 기대 건수(60000 / expected_interval_ms). 진행 중인 현재 분은 제외.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, sensor_id::text AS metric,\n       100.0 * max(sample_count) / (60000.0 / expected_interval_ms) AS completeness\nFROM v_sensor_data_1m\nWHERE $__timeFilter(bucket) AND sensor_id IN ($sensor) AND bucket < time_bucket('1 minute', now())\nGROUP BY bucket, sensor_id, expected_interval_ms\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "경보 / 시설물",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "열린 경보 (미확인)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS open FROM v_alert_event WHERE status = 'open'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "시설물별 센서 상태",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 4,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.facility_id AS facility,\n       count(*) AS sensors,\n       count(*) FILTER (WHERE st.status = 'online') AS online,\n       count(*) FILTER (WHERE st.status = 'offline') AS offline,\n       count(*) FILTER (WHERE st.status = 'faulty') AS faulty,\n       count(*) FILTER (WHERE COALESCE(st.status, 'unknown') = 'unknown') AS unknown\nFROM v_sensor s LEFT JOIN v_sensor_status st ON st.sensor_id = s.id\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "경보 발생 추이 (심각도별)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(created_at, '1m') AS time, severity AS metric, count(*) AS alerts\nFROM v_alert_event WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "table",
      "title": "경보 목록 (최근 50건)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS \"발생\", rule_name AS \"규칙\", severity AS \"심각도\", sensor_id AS \"센서\", value AS \"값\", status AS \"상태\",\n       changed_by AS \"처리자\", status_changed_at AS \"상태 변경\"\nFROM v_alert_event ORDER BY created_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
