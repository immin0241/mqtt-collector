# 인증 없이 쓰려면 tcp://broker1:1883 (익명), ACL 적용은 1884
MQTT_BROKER=tcp://broker1:1884
MQTT_USERNAME=viewer
MQTT_PASSWORD=viewer123
# worker 전용 DB role (scripts/provision_roles.sh 로 생성)
DATABASE_URL=host=postgres user=app_worker password=worker dbname=go port=5432 sslmode=disable TimeZone=Asia/Seoul
POSTGRESQL_URL=postgres://go:go@localhost:5432/go?sslmode=disable&timezone=Asia/Seoul
# health checker (선택)
# HEALTH_MIN_TIMEOUT=2s
# HEALTH_TICK=1s

# --- Grafana + Logto (docs/logto-grafana-setup.md 참고) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_OAUTH_ENABLED=false
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
# "<Logto organization id>:<Grafana org id>:<role>" (여러 개는 공백으로 구분)
GRAFANA_OAUTH_ORG_MAPPING=
